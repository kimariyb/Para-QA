# Dify workflow used to generate QAC records from Markdown files.
DIFY_QAC_API_KEY=
DIFY_UPLOAD_FILE_URL=http://127.0.0.1:5001/v1/files/upload
DIFY_WORKFLOW_RUN_URL=http://127.0.0.1:5001/v1/workflows/run
DIFY_WORKFLOW_LOG_URL=http://127.0.0.1:5001/v1/workflows/logs

# Dify chat API used by the RAG evaluation notebook.
DIFY_RAG_API_KEY=
DIFY_RAG_CHAT_URL=http://127.0.0.1:5001/v1/chat-messages

# Stable user identifier sent to Dify APIs.
DIFY_USER=abc-123
