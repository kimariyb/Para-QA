# Legacy Dify chat settings for the archived evaluation notebook only.
# QAC v2 generation does not use Dify.
DIFY_RAG_API_KEY=
DIFY_RAG_CHAT_URL=http://127.0.0.1:5001/v1/chat-messages

# Stable user identifier sent to Dify APIs.
DIFY_USER=abc-123

# OpenAI-compatible endpoint for QAC v2 generation (any provider:
# OpenAI, DeepSeek, Qwen, vLLM, Xinference, Ollama, ...).
QAC_LLM_BASE_URL=https://api.openai.com/v1
QAC_LLM_API_KEY=
QAC_LLM_MODEL=gpt-4o-mini
# QAC generation and verification default to no reasoning tokens. Keep this as
# `none` for the study; changing it creates a different registered condition.
QAC_LLM_REASONING_EFFORT=none
# Optional provider-specific request body. Example for providers that use a
# non-standard switch: {"thinking":{"type":"disabled"}}
QAC_LLM_EXTRA_BODY_JSON=
# Optional: use a different model to verify generated QA pairs
# (falls back to QAC_LLM_MODEL when empty).
QAC_LLM_VERIFIER_MODEL=

# OpenAI-compatible endpoint used later by RAG answer generation and
# evaluation (kept separate from QAC generation on purpose).
EVAL_LLM_BASE_URL=https://api.openai.com/v1
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=gpt-4o-mini

# Independent automated judge used only for evaluation, never for QAC creation
# or answer generation.
JUDGE_LLM_BASE_URL=https://api.openai.com/v1
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=
